# Copy to .env.local (it is git-ignored). Secrets here are read by Node only: the Vite dev server's
# Kroger proxy (app/vite.config.ts), the production server (server/app.mjs, on Render these are set in
# the Render dashboard instead) and scripts/probe-kroger.mjs. They are never sent to the browser.
# Fill in values yourself. Never commit them and never paste them into chat.

# Kroger developer app (https://developer.kroger.com), Production environment, Products API.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# OAuth scope for product and price lookups.
KROGER_SCOPE=product.compact
# Only used by scripts/probe-kroger.mjs: the ZIP and search term for its smoke check.
KROGER_ZIP=
KROGER_TEST_TERM=

# MangiSoz speech / OCR service. Operator credentials: never prefix secrets with VITE_.
MANGISOZ_BASE_URL=
MANGISOZ_API_KEY=

# Production server only (server/): optional overrides.
# PORT is set by Render. RATE_LIMIT_PER_MINUTE caps Kroger lookups per visitor (default 90).
# KROGER_API_BASE is only changed by the server tests (they point it at a fake Kroger).
# RATE_LIMIT_PER_MINUTE=90
