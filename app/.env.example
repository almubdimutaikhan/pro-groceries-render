# Copy to app/.env.local (git-ignored). Everything with a VITE_ prefix is visible to anyone who opens
# the site, so only public values belong here.

# Stripe test-mode Payment Link for the $49/year membership. A public checkout URL, not a secret.
# Set its success URL to <your site>/#plan?checkout=success
VITE_STRIPE_PAYMENT_LINK=
# Stripe test-mode Payment Link for the $5.99/month option.
# Set its success URL to <your site>/#plan?checkout=success&period=month
VITE_STRIPE_PAYMENT_LINK_MONTHLY=

# Production only: base URL of the Kroger proxy that holds the client secret (contract in
# src/lib/credentials.ts). On Render this is `/__kroger` (set in render.yaml): ../server serves the proxy
# from the same origin as the app. Empty = no proxy: the build runs on labelled demo prices.
# `npm run dev` has its own proxy at /__kroger and ignores this unless set.
VITE_KROGER_PROXY_BASE=

# Development only (`npm run dev`); removed from production builds. Prefill the keys so they survive a reload.
# VITE_MANGISOZ_KEY=
# VITE_OPENROUTER_KEY=

# Live Kroger prices in development need KROGER_CLIENT_ID and KROGER_CLIENT_SECRET in the repository
# root .env.local (no VITE_ prefix). See ../.env.example.
